{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jiffoo-shop",
  "main": "cloudflare-entry.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "THEME_ASSETS", "bucket_name": "jiffoo-theme-assets" }],
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "jiffoo-shop",
      "routes": [{ "pattern": "demo.jiffoo.com", "custom_domain": true }],
      "vars": {
        "API_SERVICE_URL": "https://api.jiffoo.com",
        "NEXT_PUBLIC_API_URL": "/api",
        "THEME_APP_PROXY_DISABLED": "1"
      },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "jiffoo-shop" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "jiffoo-shop-cache" },
        { "binding": "THEME_ASSETS", "bucket_name": "jiffoo-theme-assets" }
      ]
    }
  }
}

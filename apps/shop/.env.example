API_SERVICE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=/api/v1
# Only the IPs/CIDRs of reverse proxies connecting directly to Shop.
# Production must start Shop with `node server.mjs`, not `next start`.
TRUSTED_PROXIES=
# Deadlines of the Shop edge towards Core: the headers of an answer must arrive
# within the first value, the body of the answer within the second. A Core that
# misses a deadline makes the Shop answer 503 with its availability code.
CORE_EDGE_TIMEOUT_MS=30000
CORE_EDGE_BODY_TIMEOUT_MS=300000
# The largest Core answer the Shop buffers, in bytes. A larger answer fails
# with the explicit code CORE_RESPONSE_TOO_LARGE instead of a truncation.
CORE_EDGE_MAX_RESPONSE_BYTES=16777216

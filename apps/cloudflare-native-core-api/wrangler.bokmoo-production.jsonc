{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bokmoo-production-core-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/1 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bokmoo-production",
    "database_id": "2a174c03-a459-4c80-882f-8585b5d76541",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "edab3e7146014398afb8c2e25cb1a3ae" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "bokmoo-production-assets" }],
  "secrets_store_secrets": [
    { "binding": "JWT_SECRET", "store_id": "5a0c62abb59f4c1b892d1c15f723e528", "secret_name": "bokmoo_jwt_secret" },
    { "binding": "STRIPE_SECRET_KEY", "store_id": "5a0c62abb59f4c1b892d1c15f723e528", "secret_name": "bokmoo_stripe_secret_key" },
    { "binding": "STRIPE_WEBHOOK_SECRET", "store_id": "5a0c62abb59f4c1b892d1c15f723e528", "secret_name": "bokmoo_stripe_webhook_secret" },
    { "binding": "SMTP_PASSWORD", "store_id": "5a0c62abb59f4c1b892d1c15f723e528", "secret_name": "bokmoo_smtp_password" }
  ],
  "routes": [{ "pattern": "api.bokmoo.com/*", "zone_name": "bokmoo.com" }],
  "vars": {
    "CORE_ORIGIN": "https://bokmoo-api.bokmoo.com",
    "PUBLIC_API_BASE_URL": "https://api.bokmoo.com",
    "SMTP_HOST": "mail.easyeuicc.cc",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "SMTP_USERNAME": "noreply@bokmoo.com",
    "SMTP_FROM_EMAIL": "noreply@bokmoo.com",
    "SMTP_FROM_NAME": "Bokmoo",
    "SMTP_REPLY_TO": "support@bokmoo.com",
    "NATIVE_CHECKOUT_ENABLED": "false",
    "RUNTIME_VERSION": "0.0.1"
  },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}

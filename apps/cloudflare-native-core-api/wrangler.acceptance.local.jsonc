{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jiffoo-native-core-api-acceptance-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-instance-database",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "JWT_SECRET_VALUE": "local-acceptance-only-not-for-deployment",
    "CATALOG_IMPORT_TOKEN": "local-odoo-sync-only-not-for-deployment",
    "CORE_ORIGIN": "https://replace-with-instance-origin.example.com",
    "NATIVE_CHECKOUT_ENABLED": "false",
    "RUNTIME_VERSION": "0.0.1"
  }
}

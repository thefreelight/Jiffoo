{
  "schemaVersion": 1,
  "kind": "theme",
  "slug": "default-shop",
  "name": "Default Shop",
  "version": "1.1.0",
  "description": "The Core storefront presentation.",
  "author": "Jiffoo",
  "license": "MIT",
  "target": "shop",
  "tokens": {
    "background": "#f5f7f4",
    "surface": "#ffffff",
    "text": "#18312d",
    "text-muted": "#64716d",
    "border": "#d9e2db",
    "primary": "#166b52",
    "primary-foreground": "#ffffff",
    "accent": "#e4efcd",
    "font-body": "system-sans",
    "font-heading": "system-sans",
    "radius-md": "0.375rem",
    "card-radius": "0.375rem"
  },
  "fonts": [],
  "settings": [],
  "copy": {},
  "assets": {},
  "layout": {
    "header": { "variant": "logo-left", "menu": "inline", "showSearch": true },
    "footer": { "columns": [] },
    "pages": {
      "home": {
        "sections": [
          {
            "id": "home-categories",
            "type": "category-list",
            "settings": {
              "title": { "en": "Browse categories", "zh-Hans": "浏览分类", "zh-Hant": "瀏覽分類" }
            }
          },
          {
            "id": "home-products",
            "type": "product-grid",
            "settings": {
              "title": { "en": "Featured products", "zh-Hans": "精选商品", "zh-Hant": "精選商品" },
              "source": "latest"
            }
          }
        ]
      },
      "category": { "columns": 3, "showFilters": false },
      "product": { "gallery": "left", "showRelatedProducts": false }
    },
    "slots": { "category.top": [], "category.bottom": [], "product.bottom": [] }
  }
}

{
  "schemaVersion": 2,
  "kind": "theme",
  "slug": "default-shop",
  "name": "Default Shop",
  "version": "2.0.1",
  "description": "The Core storefront presentation.",
  "author": "Jiffoo",
  "license": "MIT",
  "target": "shop",
  "tokens": {
    "core": {
      "ground": "#FFFFFF",
      "raised": "#FAFAFA",
      "foreground": "#171717",
      "muted": "#5C5C5C",
      "faint": "#737373",
      "border": "#00000017",
      "active": "#0000000B",
      "attention": "#A15C07",
      "attention-soft": "#FDF6E9",
      "attention-line": "#F1DCB4",
      "destructive": "#C4281C",
      "destructive-soft": "#FDEEEC",
      "destructive-line": "#F5C7C2",
      "radius-control": "8px",
      "radius-panel": "12px",
      "font-body": "system-sans",
      "font-heading": "system-sans",
      "font-mono": "system-mono"
    },
    "extras": {
      "primary": "#171717",
      "primary-foreground": "#FFFFFF",
      "secondary": "#F4F4F5",
      "secondary-foreground": "#171717",
      "accent": "#F4F4F5",
      "success": "#1A7F4B",
      "warning": "#A15C07",
      "header-bg": "#FFFFFF",
      "header-text": "#171717",
      "footer-bg": "#FFFFFF",
      "footer-text": "#171717",
      "announcement-bg": "#171717",
      "announcement-text": "#FFFFFF",
      "price": "#171717",
      "sale-price": "#C4281C",
      "font-size-base": "1rem",
      "radius-sm": "6px",
      "radius-lg": "12px",
      "button-radius": "8px",
      "card-radius": "12px",
      "section-spacing": "3rem",
      "container-width": "1280px",
      "type-scale": 1,
      "heading-weight": 600,
      "button-style": "solid",
      "card-shadow": {
        "x": "0px",
        "y": "8px",
        "blur": "24px",
        "spread": "0px",
        "color": "#0000000F"
      }
    }
  },
  "darkTokens": {
    "core": {
      "ground": "#0A0A0A",
      "raised": "#111111",
      "foreground": "#EDEDED",
      "muted": "#A1A1A1",
      "faint": "#7C7C7C",
      "border": "#FFFFFF17",
      "active": "#FFFFFF0F",
      "attention": "#F0A640",
      "attention-soft": "#2A1D08",
      "attention-line": "#5A3C10",
      "destructive": "#FF6B5E",
      "destructive-soft": "#2C0F0C",
      "destructive-line": "#5C1D17"
    },
    "extras": {
      "primary": "#EDEDED",
      "primary-foreground": "#0A0A0A",
      "secondary": "#1C1C1C",
      "secondary-foreground": "#EDEDED",
      "accent": "#1C1C1C",
      "success": "#4CC38A",
      "header-bg": "#0A0A0A",
      "header-text": "#EDEDED",
      "footer-bg": "#0A0A0A",
      "footer-text": "#EDEDED",
      "announcement-bg": "#EDEDED",
      "announcement-text": "#0A0A0A",
      "price": "#EDEDED",
      "sale-price": "#FF6B5E"
    }
  },
  "fonts": [],
  "settings": [],
  "copy": {},
  "assets": {},
  "layout": {
    "header": {
      "variant": "logo-left",
      "menu": "inline",
      "showSearch": true
    },
    "footer": {
      "columns": []
    },
    "pages": {
      "home": {
        "sections": [
          {
            "id": "home-categories",
            "type": "category-list",
            "settings": {
              "title": {
                "en": "Browse categories",
                "zh-Hans": "浏览分类",
                "zh-Hant": "瀏覽分類"
              }
            }
          },
          {
            "id": "home-products",
            "type": "product-grid",
            "settings": {
              "title": {
                "en": "Featured products",
                "zh-Hans": "精选商品",
                "zh-Hant": "精選商品"
              },
              "source": "latest"
            }
          }
        ]
      },
      "category": {
        "columns": 3,
        "showFilters": false
      },
      "product": {
        "gallery": "left",
        "showRelatedProducts": false
      }
    },
    "slots": {
      "category.top": [],
      "category.bottom": [],
      "product.bottom": []
    }
  }
}

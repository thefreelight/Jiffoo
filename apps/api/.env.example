# Core API (Open Source) - Port 3001

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Server
API_PORT=3001
API_HOST=0.0.0.0
# Only the IPs/CIDRs of reverse proxies connecting directly to the API.
# Include the Shop server address when Shop calls the API through loopback.
TRUSTED_PROXIES=

# Database (public schema)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jiffoo_core?schema=public
PLUGIN_DB_POOL_MAX=4
REDIS_URL=redis://localhost:6379

# Rate Limiting
# SECURITY: Controls behavior when Redis (rate limiter backend) becomes unavailable
# - true (RECOMMENDED): Uses in-memory fallback to continue enforcing rate limits
#   Protects against DoS attacks even when Redis fails. Memory usage bounded by LRU eviction.
# - false: Allows all requests through when Redis fails (fail-open mode)
#   NOT RECOMMENDED for production - exposes system to DoS attacks during Redis outages

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Dedicated base64 key containing at least 32 random bytes; never reuse another signing key.
PLUGIN_PAGE_TOKEN_SECRET=<operator-generated-base64-page-token-key>
PLUGIN_FILE_URL_SECRET=<operator-generated-base64-file-url-key>
PLUGIN_UPLOAD_MAX_BYTES=10485760

# Auth

# CORS
CORS_ENABLED=true
CORS_CREDENTIALS=true
CORS_ORIGIN=http://localhost:3002,http://localhost:3003

# URLs
API_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
STOREFRONT_URL=http://localhost:3003
ADMIN_URL=http://localhost:3002

# Deadlines and limits of the Admin and Shop edges towards Core.
# These are read by the Admin and the Shop processes and not by the Core API:
# set them in the environment of those applications (see deploy/compose/.env.example).
# The deadline of the headers of a Core answer and the longer deadline of its body.
CORE_EDGE_TIMEOUT_MS=30000
CORE_EDGE_BODY_TIMEOUT_MS=300000
# The largest request body the Admin buffers and the largest Core answer the Shop buffers.
CORE_EDGE_MAX_REQUEST_BYTES=33554432
CORE_EDGE_MAX_RESPONSE_BYTES=16777216

# Extensions directory (relative to project root or absolute path)
# Points to the repository root's extensions/ directory
EXTENSIONS_PATH=../../extensions

# Extension marketplace and plugin signing
# The absolute URL of the operator's static marketplace catalog; HTTPS is required.
# Leave it unset to disable marketplace browsing; local package upload still works.
# The API and the worker must see the same value.
EXTENSION_MARKETPLACE_URL=https://<operator-marketplace-host>/catalog.json
# Enables the test signing root for locally signed plugin packages.
# The API and the worker must see the same value.
EXTENSION_TEST_SIGNING_MODE=false
# The Ed25519 public key of the test signing root, distinct from the official root.
# Only read when EXTENSION_TEST_SIGNING_MODE=true.
# JIFFOO_TEST_PLUGIN_ROOT_PUBLIC_KEY=<operator-generated-ed25519-public-key>

# Merchant uploads: local is allowed only in development/test; production requires s3.
# Use the same private bucket and explicit credentials on every API and worker.
UPLOAD_STORAGE_BACKEND=local
UPLOAD_LOCAL_PATH=./uploads
# UPLOAD_S3_ENDPOINT=https://s3.example.com
# UPLOAD_S3_REGION=us-east-1
# UPLOAD_S3_BUCKET=merchant-uploads
# UPLOAD_S3_ACCESS_KEY_ID=replace-with-your-access-key
# UPLOAD_S3_SECRET_ACCESS_KEY=replace-with-your-secret-key
UPLOAD_S3_FORCE_PATH_STYLE=false

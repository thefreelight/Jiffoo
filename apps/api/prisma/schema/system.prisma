// system.prisma — User, SystemSettings

// ============================================================
// USER
// ============================================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  username  String
  password  String
  avatar    String?
  locale    String?
  role      String   @default("USER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email verification fields
  emailVerified           Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?

  // E-commerce relations
  orders          Order[]
  carts           Cart[]
  adminMembership AdminMembership?
  notifications   Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
  @@schema("public")
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================
model SystemSettings {
  id String @id @default("system")

  isInstalled Boolean   @default(false)
  installedAt DateTime?
  installedBy String?

  version               String    @default("1.0.0")
  lastUpdatedAt         DateTime?
  pluginRegistryVersion Int       @default(0)

  siteDescription String?
  faviconUrl      String?

  maintenanceMode          Boolean @default(false)
  allowRegistration        Boolean @default(true)
  requireEmailVerification Boolean @default(true)

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
  @@schema("public")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@schema("public")
}

model Notification {
  id                String             @id @default(cuid())
  type              String
  channel           String             @default("email")
  recipientUserId   String?
  recipientUser     User?              @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  toAddress         String
  locale            String
  subject           String
  html              String
  text              String
  secretJson        Json?
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  lastError         String?
  providerSlug      String?
  providerMessageId String?
  relatedType       String?
  relatedId         String?
  resentFromId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
  @@schema("public")
}

// ============================================================
// ADMIN STAFF (RBAC)
// ============================================================
model AdminMembership {
  id                 String   @id @default(cuid())
  userId             String   @unique
  role               String
  status             String   @default("ACTIVE")
  isOwner            Boolean  @default(false)
  extraPermissions   Json?
  revokedPermissions Json?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([status])
  @@map("admin_memberships")
  @@schema("public")
}

model AdminStaffAuditLog {
  id            String   @id @default(cuid())
  staffUserId   String
  staffEmail    String
  staffUsername String?
  actorUserId   String?
  actorEmail    String?
  actorUsername String?
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([staffUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_staff_audit_logs")
  @@schema("public")
}

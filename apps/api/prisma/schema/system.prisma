// system.prisma — User, AuthToken, ApiToken, SystemSettings, Notification, AdminStaffAuditLog

// ============================================================
// USER
// ============================================================
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  phone          String?   @unique
  username       String
  password       String
  sessionVersion Int       @default(0)
  avatar         String?
  locale         String?
  role           String    @default("USER")
  isActive       Boolean   @default(true)
  removedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  emailVerified Boolean @default(false)

  // E-commerce relations
  orders        Order[]
  carts         Cart[]
  notifications Notification[]
  authTokens    AuthToken[]

  // Admin list preferences
  adminListViews           AdminListView[]
  adminListColumnPreferences AdminListColumnPreference[]

  @@index([email])
  @@index([role])
  @@index([username])
  @@index([role, createdAt])
  @@index([isActive])
  @@map("users")
  @@schema("public")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE

  @@schema("public")
}

model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  codeHash   String?
  attempts   Int              @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, purpose])
  @@map("auth_tokens")
  @@schema("public")
}

// ============================================================
// API TOKEN
// ============================================================
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String
  scopes     Json
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?

  @@index([revokedAt])
  @@index([createdAt])
  @@map("api_tokens")
  @@schema("public")
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================
model SystemSettings {
  id String @id @default("system")

  isInstalled Boolean   @default(false)
  installedAt DateTime?
  installedBy String?

  version               String    @default("1.0.0")
  lastUpdatedAt         DateTime?
  pluginRegistryVersion Int       @default(0)

  siteDescription String?
  faviconUrl      String?

  maintenanceMode          Boolean @default(false)
  allowRegistration        Boolean @default(true)
  requireEmailVerification Boolean @default(true)

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
  @@schema("public")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@schema("public")
}

model Notification {
  id                String             @id @default(cuid())
  type              String
  dedupKey          String?            @unique
  channel           String             @default("email")
  recipientUserId   String?
  recipientUser     User?              @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  toAddress         String
  locale            String
  subject           String
  html              String
  text              String
  secretJson        Json?
  status            NotificationStatus @default(PENDING)
  claimToken        String?            @db.Uuid
  claimedBy         String?
  leaseUntil        DateTime?          @db.Timestamptz(3)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  lastError         String?
  providerSlug      String?
  providerMessageId String?
  relatedType       String?
  relatedId         String?
  resentFromId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([createdAt])
  @@index([recipientUserId, createdAt])
  @@index([relatedType, relatedId])
  @@index([resentFromId, createdAt])
  @@map("notifications")
  @@schema("public")
}

model AdminStaffAuditLog {
  id            String   @id @default(cuid())
  staffUserId   String
  staffEmail    String
  staffUsername String?
  actorUserId   String?
  actorEmail    String?
  actorUsername String?
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([staffUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_staff_audit_logs")
  @@schema("public")
}

// ============================================================
// ADMIN LIST PREFERENCES
// ============================================================
model AdminListView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listKey   String
  name      String
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listKey, name])
  @@index([userId, listKey])
  @@map("admin_list_views")
  @@schema("public")
}

model AdminListColumnPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listKey   String
  columns   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listKey])
  @@index([userId, listKey])
  @@map("admin_list_column_preferences")
  @@schema("public")
}

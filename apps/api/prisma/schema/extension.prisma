// extension.prisma — PluginInstall, PluginInstallation,
//                    PluginEventSubscription

// ============================================================
// PLUGIN INSTALL (package metadata)
// ============================================================
model PluginInstall {
  id   String @id @default(cuid())
  slug String @unique

  name        String
  version     String
  author      String?
  authorUrl   String?
  description String?
  category    String?

  runtimeType     String  @default("internal-fastify")
  entryModule     String?
  externalBaseUrl String?

  source      String  @default("local-zip")
  trustLevel  PluginTrustLevel @default(unsigned)
  publisherId String?
  publisherName String?
  publisherCertificateFingerprint String?
  signingRoot String?
  installPath String?

  zipHash      String?
  manifestJson Json?

  permissions Json?

  deletedAt DateTime?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installations PluginInstallation[]
  eventSubscriptions PluginEventSubscription[]
  packageBlobs PluginPackageBlob[]

  @@index([category])
  @@index([runtimeType])
  @@index([zipHash])
  @@index([deletedAt])
  @@map("plugin_installs")
  @@schema("public")
}

model PluginPackageBlob {
  id         String   @id @default(cuid())
  pluginSlug String
  zipHash    String
  bytes      Bytes
  sizeBytes  Int
  createdAt  DateTime @default(now())

  plugin PluginInstall @relation(fields: [pluginSlug], references: [slug], onDelete: Cascade)

  @@unique([pluginSlug, zipHash])
  @@map("plugin_package_blobs")
  @@schema("public")
}

model PluginOperationLease {
  slug       String   @id
  token      String
  operation  String
  acquiredAt DateTime
  expiresAt  DateTime

  @@map("plugin_operation_leases")
  @@schema("public")
}

enum PluginTrustLevel {
  builtin
  signed
  unsigned

  @@schema("public")
}

model Theme {
  id           String           @id @default(cuid())
  slug         String           @unique
  version      String
  target       String
  name         String
  manifestJson Json
  packageHash  String
  source       String
  trustLevel   PluginTrustLevel
  installedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  configuration ThemeConfiguration?
  revisions     ThemeConfigRevision[]

  @@map("themes")
  @@schema("public")
}

model ThemeActive {
  target String @id
  slug   String
  updatedAt DateTime @updatedAt

  @@map("theme_active")
  @@schema("public")
}

model ThemeActivation {
  id String @id @default(cuid())
  target String
  slug String
  actorId String
  createdAt DateTime @default(now())

  @@index([target, createdAt])
  @@map("theme_activations")
  @@schema("public")
}

model ThemeConfiguration {
  slug String @id
  revision Int @default(0)
  values Json
  updatedAt DateTime @updatedAt
  theme Theme @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@map("theme_configurations")
  @@schema("public")
}

model ThemeConfigRevision {
  id String @id @default(cuid())
  slug String
  revision Int
  values Json
  createdAt DateTime @default(now())
  theme Theme @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@unique([slug, revision])
  @@map("theme_config_revisions")
  @@schema("public")
}

model StorefrontCodeConfiguration {
  id                String   @id @default("system")
  revision          Int      @default(0)
  enabled           Boolean  @default(true)
  ga4MeasurementId  String?
  metaPixelId       String?
  baiduSiteKey      String?
  headCode          String   @default("")
  bodyStartCode     String   @default("")
  bodyEndCode       String   @default("")
  updatedById       String
  updatedAt         DateTime @updatedAt

  @@map("storefront_code_configurations")
  @@schema("public")
}

model StorefrontCodeRevision {
  id                   String   @id @default(cuid())
  revision             Int      @unique
  enabled              Boolean
  ga4MeasurementId     String?
  metaPixelId          String?
  baiduSiteKey         String?
  headCode             String
  bodyStartCode        String
  bodyEndCode          String
  updatedById          String
  updatedAt            DateTime
  createdById          String
  createdAt            DateTime @default(now())
  restoredFromRevision Int?

  @@index([createdAt, id])
  @@map("storefront_code_revisions")
  @@schema("public")
}

model AdminAuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  targetType String
  targetId String
  summary Json
  createdAt DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_events")
  @@schema("public")
}

// ============================================================
// PLUGIN INSTALLATION (instance)
// ============================================================
model PluginInstallation {
  id          String @id @default(uuid())
  pluginSlug  String
  instanceKey String

  enabled Boolean @default(true)

  configJson Json?

  grantedPermissions Json?

  deletedAt DateTime?

  lifecycleWarning String?

  lastFailureAt      DateTime?
  lastFailureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plugin               PluginInstall          @relation(fields: [pluginSlug], references: [slug], onDelete: Cascade)

  @@unique([pluginSlug, instanceKey])
  @@index([pluginSlug])
  @@index([enabled])
  @@index([deletedAt])
  @@map("plugin_installations")
  @@schema("public")
}


// extension.prisma — PluginInstall, PluginInstallation,
//                    WebhookSubscription, WebhookDeliveryLog, WebhookDeadLetter

// ============================================================
// PLUGIN INSTALL (package metadata)
// ============================================================
model PluginInstall {
  id   String @id @default(cuid())
  slug String @unique

  name        String
  version     String
  author      String?
  authorUrl   String?
  description String?
  category    String?

  runtimeType     String  @default("internal-fastify")
  entryModule     String?
  externalBaseUrl String?

  source      String  @default("local-zip")
  trustLevel  PluginTrustLevel @default(unsigned)
  installPath String?

  zipHash      String?
  manifestJson Json?

  permissions Json?

  deletedAt DateTime?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installations PluginInstallation[]

  @@index([category])
  @@index([runtimeType])
  @@index([zipHash])
  @@index([deletedAt])
  @@map("plugin_installs")
  @@schema("public")
}

enum PluginTrustLevel {
  builtin
  signed
  unsigned

  @@schema("public")
}

model Theme {
  id           String           @id @default(cuid())
  slug         String           @unique
  version      String
  target       String
  name         String
  manifestJson Json
  packageHash  String
  source       String
  trustLevel   PluginTrustLevel
  installedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  configuration ThemeConfiguration?
  revisions     ThemeConfigRevision[]

  @@map("themes")
  @@schema("public")
}

model ThemeActive {
  target String @id
  slug   String
  updatedAt DateTime @updatedAt

  @@map("theme_active")
  @@schema("public")
}

model ThemeActivation {
  id String @id @default(cuid())
  target String
  slug String
  actorId String
  createdAt DateTime @default(now())

  @@index([target, createdAt])
  @@map("theme_activations")
  @@schema("public")
}

model ThemeConfiguration {
  slug String @id
  revision Int @default(0)
  values Json
  updatedAt DateTime @updatedAt
  theme Theme @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@map("theme_configurations")
  @@schema("public")
}

model ThemeConfigRevision {
  id String @id @default(cuid())
  slug String
  revision Int
  values Json
  createdAt DateTime @default(now())
  theme Theme @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@unique([slug, revision])
  @@map("theme_config_revisions")
  @@schema("public")
}

model StorefrontCodeConfiguration {
  id                String   @id @default("system")
  revision          Int      @default(0)
  enabled           Boolean  @default(true)
  ga4MeasurementId  String?
  metaPixelId       String?
  baiduSiteKey      String?
  headCode          String   @default("")
  bodyStartCode     String   @default("")
  bodyEndCode       String   @default("")
  updatedById       String
  updatedAt         DateTime @updatedAt

  @@map("storefront_code_configurations")
  @@schema("public")
}

model StorefrontCodeRevision {
  id                   String   @id @default(cuid())
  revision             Int      @unique
  enabled              Boolean
  ga4MeasurementId     String?
  metaPixelId          String?
  baiduSiteKey         String?
  headCode             String
  bodyStartCode        String
  bodyEndCode          String
  updatedById          String
  updatedAt            DateTime
  createdById          String
  createdAt            DateTime @default(now())
  restoredFromRevision Int?

  @@index([createdAt, id])
  @@map("storefront_code_revisions")
  @@schema("public")
}

model AdminAuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  targetType String
  targetId String
  summary Json
  createdAt DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_events")
  @@schema("public")
}

// ============================================================
// PLUGIN INSTALLATION (instance)
// ============================================================
model PluginInstallation {
  id          String @id @default(uuid())
  pluginSlug  String
  instanceKey String

  enabled Boolean @default(true)

  configJson Json?

  grantedPermissions Json?

  deletedAt DateTime?

  lifecycleWarning String?

  lastFailureAt      DateTime?
  lastFailureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plugin               PluginInstall          @relation(fields: [pluginSlug], references: [slug], onDelete: Cascade)
  webhookSubscriptions WebhookSubscription[]

  @@unique([pluginSlug, instanceKey])
  @@index([pluginSlug])
  @@index([enabled])
  @@index([deletedAt])
  @@map("plugin_installations")
  @@schema("public")
}

// ============================================================
// WEBHOOK SUBSCRIPTION
// ============================================================
model WebhookSubscription {
  id             String   @id @default(cuid())
  installationId String
  eventType      String
  deliveryMode   String   @default("internal")
  endpointUrl    String?
  secret         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation PluginInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  deliveryLogs WebhookDeliveryLog[]
  deadLetters  WebhookDeadLetter[]

  @@index([installationId])
  @@index([eventType])
  @@index([active])
  @@map("webhook_subscriptions")
  @@schema("public")
}

// ============================================================
// WEBHOOK DELIVERY LOG
// ============================================================
model WebhookDeliveryLog {
  id             String   @id @default(cuid())
  subscriptionId String
  eventId        String
  attempt        Int      @default(1)
  status         String
  responseCode   Int?
  responseBody   String?
  errorMessage   String?
  deliveredAt    DateTime @default(now())
  latencyMs      Int?

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventId])
  @@index([status])
  @@map("webhook_delivery_logs")
  @@schema("public")
}

// ============================================================
// WEBHOOK DEAD LETTER
// ============================================================
model WebhookDeadLetter {
  id             String    @id @default(cuid())
  eventId        String
  subscriptionId String
  eventType      String
  payload        Json
  lastError      String?
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  replayedAt     DateTime?

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventId])
  @@index([eventType])
  @@map("webhook_dead_letters")
  @@schema("public")
}

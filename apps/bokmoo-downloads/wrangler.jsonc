{
  "name": "bokmoo-production-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // The route (bokmoo.com/downloads/*) is managed on the zone, as with the other instance configs.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "bokmoo-downloads" }],
  "vars": { "RUNTIME_VERSION": "1.0.168" }
}

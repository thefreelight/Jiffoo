{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jiffoo-admin-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "API_SERVICE_URL": "https://demo-api.jiffoo.com",
    "NEXT_PUBLIC_API_URL": "/api",
    "NEXT_PUBLIC_ADMIN_URL": "https://demo-admin.jiffoo.com",
    "JIFFOO_RUNTIME_VERSION": "admin-ui-redesign-6d6e69213",
    "THEME_APP_PROXY_DISABLED": "1"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "jiffoo-admin-demo", "environment": "production" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "jiffoo-admin-cache" }],
  "routes": [{ "pattern": "demo-admin.jiffoo.com/*", "zone_name": "jiffoo.com" }]
}

{
  "name": "jiffoo-theme-api-sdk",
  "version": "0.3.0",
  "description": "Theme-facing SDK for Jiffoo Mall Core API",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "jiffoo",
    "theme",
    "sdk",
    "core-api"
  ],
  "author": "Jiffoo Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "jiffoo-core-api-sdk": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "shared": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^1.6.0"
  }
}

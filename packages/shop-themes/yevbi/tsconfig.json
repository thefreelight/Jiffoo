{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "shared": [
        "../../shared"
      ],
      "shared/types/theme": [
        "../../shared/dist/shared/src/types/theme.d.ts"
      ],
      "shared/types/dto": [
        "../../shared/dist/shared/src/types/dto/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brand": {
      "type": "object",
      "title": "Brand",
      "properties": {
        "name": {
          "type": "string",
          "title": "Brand Name",
          "default": "Bokmoo"
        },
        "primaryColor": {
          "type": "string",
          "title": "Primary Color",
          "format": "color",
          "default": "#d7b23d"
        },
        "secondaryColor": {
          "type": "string",
          "title": "Secondary Color",
          "format": "color",
          "default": "#11100d"
        },
        "fontFamily": {
          "type": "string",
          "title": "Body Font",
          "default": "\"Avenir Next\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif"
        }
      }
    },
    "site": {
      "type": "object",
      "title": "Site",
      "properties": {
        "eyebrow": {
          "type": "string",
          "title": "Hero Eyebrow",
          "default": "BOKMOO eSIM Card"
        },
        "headline": {
          "type": "string",
          "title": "Hero Headline",
          "default": "One Card.\nGlobal Connection."
        },
        "subheadline": {
          "type": "string",
          "title": "Hero Description",
          "default": "Use multiple eSIM profiles on your BOKMOO card. Stay connected in 200+ countries."
        },
        "primaryCtaLabel": {
          "type": "string",
          "title": "Primary CTA Label",
          "default": "Shop eSIM Plans"
        },
        "primaryCtaHref": {
          "type": "string",
          "title": "Primary CTA Link",
          "default": "/products"
        },
        "secondaryCtaLabel": {
          "type": "string",
          "title": "Secondary CTA Label",
          "default": "How it works"
        },
        "secondaryCtaHref": {
          "type": "string",
          "title": "Secondary CTA Link",
          "default": "/#how-it-works"
        },
        "apiBaseUrl": {
          "type": "string",
          "title": "Bokmoo API Base URL",
          "default": "https://api.bokmoo.com"
        },
        "supportEmail": {
          "type": "string",
          "title": "Support Email",
          "default": "support@bokmoo.com"
        },
        "promoPoster": {
          "type": "string",
          "title": "Promo Film Poster (URL)",
          "description": "Poster image of the home page film, for narrow screens. Set to \"none\" to hide the film.",
          "default": "/extensions/media/promo/v3/bokmoo-promo-poster-1280.jpg"
        },
        "promoMutedVideo": {
          "type": "string",
          "title": "Promo Film — Muted Video (URL)",
          "description": "The home page film without sound, played in a loop on wide screens.",
          "default": "/extensions/media/promo/v3/bokmoo-promo-720p-muted.mp4"
        },
        "promoMutedVideoSmall": {
          "type": "string",
          "title": "Promo Film — Muted Video for Phones (URL)",
          "description": "The home page film without sound, played in a loop on narrow screens.",
          "default": "/extensions/media/promo/v3/bokmoo-promo-540p-muted.mp4"
        },
        "promoSoundVideo": {
          "type": "string",
          "title": "Promo Film — Video with Sound (URL)",
          "description": "The home page film with its narration, loaded when the visitor asks for sound.",
          "default": "/extensions/media/promo/v3/bokmoo-promo-720p.mp4"
        },
        "catalogProducts": {
          "type": "string",
          "title": "Catalog Page Lists",
          "description": "What the catalog page shows: cards (physical products only), plans (data plans only) or all.",
          "enum": ["cards", "plans", "all"],
          "default": "cards"
        }
      }
    }
  }
}

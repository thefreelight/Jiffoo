{
  "schemaVersion": 2,
  "kind": "theme",
  "slug": "e2e-admin-theme",
  "name": "E2E Admin Theme",
  "version": "1.0.0",
  "description": "An Admin theme for the browser workflow.",
  "author": "Jiffoo",
  "license": "MIT",
  "target": "admin",
  "tokens": {
    "core": {
      "ground": "#FFFFFF",
      "raised": "#FAFAFA",
      "foreground": "#cc0033",
      "muted": "#5C5C5C",
      "faint": "#737373",
      "border": "#00000017",
      "active": "#0000000D",
      "attention": "#B4470E",
      "attention-soft": "#FFF6F0",
      "attention-line": "#B4470E38",
      "destructive": "#B91C1C",
      "destructive-soft": "#FEF2F2",
      "destructive-line": "#B91C1C38",
      "radius-control": "7px",
      "radius-panel": "10px",
      "font-body": "e2e-outfit",
      "font-heading": "system-sans",
      "font-mono": "system-mono"
    },
    "extras": {
      "primary-foreground": "#FFFFFF",
      "focus-ring": "#171717",
      "hover": "#80808012",
      "overlay": "#00000080",
      "sidebar-background": "#FFFFFF",
      "sidebar-foreground": "#5C5C5C",
      "sidebar-active": "#0000000D"
    }
  },
  "fonts": [
    {
      "id": "e2e-outfit",
      "family": "E2E Outfit",
      "file": "fonts/outfit.woff2",
      "weight": 400,
      "style": "normal",
      "license": "OFL-1.1"
    }
  ],
  "settings": [],
  "copy": {},
  "assets": {
    "logo": "assets/logo.png",
    "login-background": "assets/login.png"
  }
}

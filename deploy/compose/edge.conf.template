pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  access_log /dev/stdout;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server {
    listen 8443 ssl;
    server_name ${EDGE_SHOP_HOST};
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;
    # Preserve the public port; Core still requires an exact configured origin.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto https;
    location = /health { access_log off; return 200 'ok'; }
    location /api/ { proxy_pass http://api-lb:8080; }
    location /uploads/ { proxy_pass http://api-lb:8080; }
    location /themes/ { proxy_pass http://api-lb:8080; }
    location / { proxy_pass http://api-lb:3003; }
  }
  server {
    listen 8443 ssl;
    server_name ${EDGE_ADMIN_HOST};
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;
    # Preserve the public port; Core still requires an exact configured origin.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto https;
    location = /health { access_log off; return 200 'ok'; }
    location /api/ { proxy_pass http://api-lb:8080; }
    location /uploads/ { proxy_pass http://api-lb:8080; }
    location /themes/ { proxy_pass http://api-lb:8080; }
    location / { proxy_pass http://admin:3002; }
  }
}

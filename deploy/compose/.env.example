# Generate secrets locally; never commit a real .env or private key.
# Use a unique COMPOSE_PROJECT_NAME for each installation.
COMPOSE_PROJECT_NAME=<unique-project-name>
JWT_SECRET=<operator-generated-secret-at-least-32-characters>
PLUGIN_SECRETS_KEY=<operator-generated-base64-32-byte-key>
PLUGIN_PAGE_TOKEN_SECRET=<independent-operator-generated-base64-page-token-key>
PLUGIN_FILE_URL_SECRET=<independent-operator-generated-base64-file-url-key>
PLUGIN_UPLOAD_MAX_BYTES=10485760
POSTGRES_PASSWORD=<operator-generated-url-safe-database-password>
MINIO_ROOT_USER=<operator-generated-s3-root-access-key>
MINIO_ROOT_PASSWORD=<operator-generated-s3-root-secret-key>
SILO_APP_ACCESS_KEY_ID=<operator-generated-s3-application-access-key>
SILO_APP_SECRET_ACCESS_KEY=<operator-generated-s3-application-secret-key>
UPLOAD_S3_BUCKET=<operator-chosen-bucket-name>
STOREFRONT_URL=<https-shop-origin>
ADMIN_URL=<https-admin-origin>
# Deadlines of the Admin and Shop edges towards Core: the headers of an answer
# must arrive within the first value, the body of the answer within the second.
# A Core that misses a deadline makes the edge answer 503.
CORE_EDGE_TIMEOUT_MS=30000
CORE_EDGE_BODY_TIMEOUT_MS=300000
# Limits of the edges: the request body the Admin buffers and the Core answer
# the Shop buffers. Raise them only for the uploads and answers of a deployment.
CORE_EDGE_MAX_REQUEST_BYTES=33554432
CORE_EDGE_MAX_RESPONSE_BYTES=16777216
TLS_CERT_FILE=<absolute-path-to-certificate-pem>
TLS_KEY_FILE=<absolute-path-to-private-key-pem>
EDGE_PORT=<host-https-port>
REVISION=<source-commit-sha>

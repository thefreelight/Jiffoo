{
  "name": "jiffoo-mall-core",
  "version": "1.0.154-opensource",
  "description": "Jiffoo open-source core for self-hosted commerce deployments",
  "_moduleAliases": {
    "@shared/security": "packages/shared/dist/shared/src/security",
    "shared/logger": "packages/shared/dist/shared/src/logger",
    "@jiffoo/shared": "packages/shared/dist/shared/src"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=api --filter=admin --concurrency=5",
    "dev:core": "dotenv -e .env -- turbo run dev --filter=api --filter=admin --concurrency=5",
    "dev:minimal": "turbo run dev --filter=api --concurrency=2",
    "dev:api-only": "dotenv -e .env -- pnpm --filter api dev",
    "dev:admin-only": "dotenv -e .env -- pnpm --filter admin dev",
    "dev:packages": "turbo run dev --filter='./packages/**' --concurrency=8",
    "build": "turbo run build",
    "build:core": "turbo run build --filter=api --filter=admin",
    "pages:build:admin": "pnpm --filter admin pages:build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "dev:api": "pnpm --filter api dev",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "db:reset": "pnpm --filter api db:reset",
    "db:seed": "pnpm --filter api db:seed",
    "test": "turbo run test",
    "test:api:quality": "pnpm --filter api test:quality",
    "test:e2e:all": "pnpm test:e2e:admin",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "changeset": "changeset",
    "version:bump": "changeset version",
    "release": "pnpm version:bump && pnpm build"
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "pnpm --filter api exec eslint --fix"
    ],
    "apps/admin/**/*.{ts,tsx}": [
      "pnpm --filter admin exec eslint --fix"
    ]
  },
  "keywords": [
    "fastify",
    "typescript",
    "mall",
    "ecommerce"
  ],
  "author": "Jiffoo Team",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.57.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^10.0.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^4.1.1",
    "lint-staged": "^16.2.7",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "stripe": "18.4.0",
      "next": "16.0.7"
    }
  }
}

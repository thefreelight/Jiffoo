{
  "name": "jiffoo-mall-core",
  "version": "1.0.154-opensource",
  "description": "Jiffoo open-source core for self-hosted commerce deployments",
  "_moduleAliases": {
    "@shared/security": "packages/shared/dist/shared/src/security",
    "shared/logger": "packages/shared/dist/shared/src/logger",
    "@jiffoo/shared": "packages/shared/dist/shared/src"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/shop",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev dev:worker --filter=api --filter=admin --concurrency=5",
    "dev:core": "dotenv -e .env -- turbo run dev --filter=api --filter=admin --concurrency=5",
    "dev:minimal": "turbo run dev --filter=api --concurrency=2",
    "dev:api-only": "dotenv -e .env -- pnpm --filter api dev",
    "dev:admin-only": "dotenv -e .env -- pnpm --filter admin dev",
    "dev:packages": "turbo run dev --filter='./packages/**' --concurrency=8",
    "build": "turbo run build",
    "build:core": "turbo run build --filter=api --filter=admin",
    "start": "turbo run start start:worker",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "dev:api": "pnpm --filter api dev",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "db:reset": "pnpm --filter api db:reset",
    "db:seed": "pnpm --filter api db:seed",
    "test": "turbo run test",
    "test:api:quality": "pnpm --filter api test:quality",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:compose": "node scripts/verify-compose.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "verify:trial": "node scripts/verify-trial.mjs",
    "trial:up": "node scripts/local-trial.mjs up",
    "trial:status": "node scripts/local-trial.mjs status",
    "trial:logs": "node scripts/local-trial.mjs logs",
    "trial:down": "node scripts/local-trial.mjs down",
    "trial:backup": "node scripts/local-trial.mjs backup",
    "trial:update": "node scripts/local-trial.mjs update",
    "trial:restore": "node scripts/local-trial.mjs restore",
    "trial:destroy": "node scripts/local-trial.mjs destroy",
    "visual:capture": "node scripts/verify-e2e.mjs --visual",
    "visual:compare": "node scripts/verify-e2e.mjs --visual --compare"
  },
  "keywords": [
    "fastify",
    "typescript",
    "mall",
    "ecommerce"
  ],
  "author": "Jiffoo Team",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
